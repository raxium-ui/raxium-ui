{
  "name": "@raxium/react",
  "type": "module",
  "version": "0.5.3",
  "packageManager": "pnpm@10.13.1",
  "description": "React core components for Raxium, based on Ark UI",
  "author": {
    "name": "Hwacc",
    "email": "mshcccck@gmail.com",
    "url": "https://github.com/hwacc/raxium-ui"
  },
  "license": "MIT",
  "keywords": [
    "raxium",
    "raxium-ui",
    "ark-ui",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*/index.d.ts",
      "import": "./dist/providers/*/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    }
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build --tsconfig ./tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "lint": "eslint src --fix"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.35.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@raxium/shared": "workspace:*",
    "@raxium/themes": "workspace:*",
    "es-toolkit": "^1.44.0",
    "lucide-react": "^1.33.0"
  },
  "devDependencies": {
    "@ark-ui/react": "5.38.1",
    "@internationalized/date": "^3.10.1",
    "@raxium/shared": "workspace:*",
    "@raxium/themes": "workspace:*",
    "@rsbuild/plugin-react": "^1.4.4",
    "@rslib/core": "^0.23.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsc-alias": "^1.8.16",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
